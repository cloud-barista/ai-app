# Optional overrides for docker compose.
#
# Nothing here is required: `docker compose up -d` starts with the built-in
# defaults. Copy this to .env only to point the service at a real CB-Tumblebug
# or to give it a planning model.
#
#   cp .env.example .env
#
# .env is git-ignored on purpose: never commit real endpoints or credentials.

# Ports published on the host: the AI-App service, the automation engine and
# the partner natural language agent mock.
#AIAPP_SERVER_PORT=8090
#AIAPP_ENGINE_PORT=8091
#AIAPP_MOCK_NL_PORT=8093

# Bearer token required on every route but readiness, the console and Swagger.
# Every service and the MCP connections of the engine and the agent mock get this
# same value, because the AI-App service forwards engine and partner agent routes
# with the caller's Authorization header.
# Empty leaves authentication off.
#AIAPP_AUTH_TOKEN=

# CB-Tumblebug. Without this the deployment path plans and reviews but reaches
# no platform; everything else works.
#AIAPP_TUMBLEBUG_BASE_URL=http://<host>:1323/tumblebug
#AIAPP_TUMBLEBUG_USERNAME=
#AIAPP_TUMBLEBUG_PASSWORD=

# The write gate for create, control, delete and update (update runs the install
# commands on the nodes again). The read-only remote commands of
# probe_accelerator and check_serving_health are not gated and run either way.
# Leave it on unless you mean to provision billable resources.
#AIAPP_TUMBLEBUG_DRY_RUN=true

# How long a deployment asked with waitHealthy=true waits for the application
# to answer on its serving port, and how often it asks.
#AIAPP_HEALTH_TIMEOUT=15m
#AIAPP_HEALTH_INTERVAL=20s

# Spec and image recommendation come from the partner recommender API. The
# compose default is the partner recommender mock service; set it empty to run
# without a recommender, where every plan must pin specId and imageId.
#AIAPP_RECOMMENDER_URL=http://mock-partner-recommender:8092
#AIAPP_RECOMMENDER_TOKEN=
#AIAPP_MOCK_RECOMMENDER_PORT=8092

# Provisioning is local (CB-Tumblebug) unless pointed at an external service.
# remote needs the URL.
#AIAPP_PROVISIONER=local
#AIAPP_PROVISIONER_URL=
#AIAPP_PROVISIONER_TOKEN=

# Semaphore runs the deployment playbooks (deploy/ansible) on a node over SSH.
# Start it with `docker compose --profile deploy up -d`; it refuses to start
# without a password, because Semaphore logs anyone in with an empty one. The
# same user name and password create the Semaphore admin and are what the
# AI-App service logs in with. A token, when set, is used instead of them.
#AIAPP_SEMAPHORE_URL=http://semaphore:3000
#AIAPP_SEMAPHORE_USERNAME=admin
#AIAPP_SEMAPHORE_PASSWORD=
#AIAPP_SEMAPHORE_TOKEN=
#AIAPP_SEMAPHORE_PORT=3001
#AIAPP_SEMAPHORE_PROJECT=aiapp
# How often a running playbook is checked, and how long it may run.
#AIAPP_SEMAPHORE_POLL_INTERVAL=5s
#AIAPP_SEMAPHORE_TIMEOUT=30m
# Folder deployment files are placed in, read by Semaphore at the same path.
# docker compose fixes it to the shared stage volume and ignores this value;
# it is read when the AI-App service runs outside compose.
#AIAPP_STAGE_ROOT=/var/lib/aiapp/stage

# Agent registry the automation engine posts its card to at startup
# (POST <url>/agents). Empty leaves registration off; a failed registration
# never stops the engine.
#AIAPP_ENGINE_REGISTRY_URL=
#AIAPP_ENGINE_REGISTRY_TOKEN=

# Partner institution natural language agent (mock implementation, not part of
# this prototype). It calls the automation engine tools over MCP. Agent registry
# its card is posted to at startup (POST <url>/agents); empty leaves
# registration off and a failed registration never stops it.
#AIAPP_MOCK_NL_REGISTRY_URL=
#AIAPP_MOCK_NL_REGISTRY_TOKEN=
#AIAPP_MOCK_NL_MAX_STEPS=12

# Planning model of the natural language agent mock. Without a key its intent
# endpoint reports 503 and the other services are unaffected.
#AIAPP_LLM_BASE_URL=https://api.anthropic.com
#AIAPP_LLM_API_KEY=
#AIAPP_LLM_MODEL=claude-opus-5
#AIAPP_LLM_TIMEOUT=5m
