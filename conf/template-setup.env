# ai-agent-proto runtime configuration template.
# Copy to conf/setup.env, fill in real values, and source it before starting the server.
# conf/setup.env is git-ignored on purpose: never commit real endpoints or credentials.

# HTTP port the AI-App service (cmd/ai-app-server) listens on.
export AIAPP_SERVER_PORT=8090

# HTTP port the automation engine (cmd/ai-automation-engine) listens on. The
# engine runs the deploy, heal, control and status workflows as ordered AI-App
# tool calls and uses no LLM.
export AIAPP_ENGINE_PORT=8091

# Where the AI-App service forwards engine routes (/aiapp/engine/*, path
# unchanged, MCP endpoint /aiapp/engine/mcp included).
export AIAPP_ENGINE_URL=http://127.0.0.1:8091

# Directory holding the engine run archive (JSON Lines), every workflow step
# with its input, result and whether the dry-run gate held it.
export AIAPP_ENGINE_ARCHIVE_DIR=./data/engine-archive

# Agent registry the engine registers its card with (POST <url>/agents), with
# the same retries as the partner agent mock registration below. The outcome
# is shown under "registration" of GET /aiapp/engine/card. Empty leaves
# registration off.
export AIAPP_ENGINE_REGISTRY_URL=
# Bearer token sent to the agent registry by the engine. Empty sends none.
export AIAPP_ENGINE_REGISTRY_TOKEN=

# Where the AI-App service forwards the partner natural language agent routes
# (/aiapp/partner/nl/*, path unchanged). Natural language interpretation is the
# partner institution's area; until its agent exists this is the mock below.
export AIAPP_MOCK_NL_URL=http://127.0.0.1:8093

# AI-App MCP server the engine takes its tools from.
export AIAPP_APP_MCP_URL=http://127.0.0.1:8090/aiapp/mcp

# Bearer token each process requires on every route but /aiapp/readyz, the
# console (/aiapp/ui) and Swagger (/aiapp/api/*). The AI-App service also leaves
# /aiapp/partner/nl/readyz and /aiapp/engine/readyz open. Empty turns
# authentication off, which the startup log reports.
# The AI-App service forwards engine and partner agent routes with the caller's
# Authorization header unchanged, so every process must be given the same token.
export AIAPP_AUTH_TOKEN=

# Bearer token the engine sends to the AI-App MCP server. Set it to the same
# value as AIAPP_AUTH_TOKEN of the AI-App service.
export AIAPP_APP_TOKEN=

# CB-Tumblebug base URL, e.g. http://<host>:<port>/tumblebug
export AIAPP_TUMBLEBUG_BASE_URL=

# CB-Tumblebug basic auth credentials.
export AIAPP_TUMBLEBUG_USERNAME=
export AIAPP_TUMBLEBUG_PASSWORD=

# Timeout for calls to CB-Tumblebug.
# Infra creation blocks until provisioning finishes; cancelling mid-flight can
# leave billable orphan resources behind, so keep this generous.
export AIAPP_TUMBLEBUG_TIMEOUT=20m

# Optional: x-credential-holder header value. Empty uses the server default holder.
export AIAPP_TUMBLEBUG_CREDENTIAL_HOLDER=

# Namespace holding the shared node image catalog. Images live here, not in the
# namespace a deployment is created in.
export AIAPP_TUMBLEBUG_IMAGE_NAMESPACE=system

# Namespace holding the shared node spec catalog.
export AIAPP_TUMBLEBUG_SPEC_NAMESPACE=system

# Image family used when an AI application does not name one.
export AIAPP_TUMBLEBUG_DEFAULT_OS_TYPE="ubuntu 22.04"

# Guard for calls that change infrastructure: create, control, delete and update
# (update runs the install commands on the nodes again through the remote command
# channel). The read-only remote commands of probe_accelerator and
# check_serving_health are not guarded and run either way.
# true  - the guarded call is planned and archived, but never sent.
# false - the guarded call is sent; create provisions and bills. Only flip this deliberately.
export AIAPP_TUMBLEBUG_DRY_RUN=true

# How long POST /aiapp/ns/{nsId}/deployments?waitHealthy=true keeps asking each
# node whether the application answers on its serving port (curl to 127.0.0.1
# through the CB-Tumblebug remote command channel), and how often. Without
# waitHealthy, and from the deploy_ai_app tool, the nodes are asked once.
# Running out of time is reported under "health" and does not fail the deployment.
# The engine reads the same two settings for its deploy and heal steps that wait
# for the application to answer; there, running out of time fails the step.
export AIAPP_HEALTH_TIMEOUT=15m
export AIAPP_HEALTH_INTERVAL=20s

# The partner recommender API that picks the node spec and image of a plan.
# Infrastructure recommendation is the partner institution's area, so this
# service does not recommend on its own. Empty means no recommender: every plan
# must pin specId and imageId, and otherwise answers 422. To use the partner
# recommender mock, start it with `make run-mock-recommender` and set
# http://127.0.0.1:8092. The token, when set, is sent as a bearer token.
export AIAPP_RECOMMENDER_URL=
export AIAPP_RECOMMENDER_TOKEN=

# Partner recommender mock (mock/partner/recommender, not part of this
# prototype). It reads the AIAPP_TUMBLEBUG_* settings above. A non-empty token
# is required of callers; give the AI-App service the same AIAPP_RECOMMENDER_TOKEN.
export AIAPP_MOCK_RECOMMENDER_PORT=8092
export AIAPP_MOCK_RECOMMENDER_TOKEN=

# Who reviews, creates and updates the Infra of a deployment.
# local  - this service, through CB-Tumblebug.
# remote - an external provisioning service at AIAPP_PROVISIONER_URL. Required then.
# Its calls share AIAPP_TUMBLEBUG_TIMEOUT, because a create blocks either way.
export AIAPP_PROVISIONER=local
export AIAPP_PROVISIONER_URL=
export AIAPP_PROVISIONER_TOKEN=

# Directory holding the AI-App deployment/control archive (JSON Lines).
export AIAPP_ARCHIVE_DIR=./data/archive

# Semaphore UI, which runs the playbooks of deploy/ansible on a node over SSH.
# Empty URL leaves node deployment unavailable. A token, when set, is used
# instead of the user name and password; missing credentials are reported when
# a deployment reaches Semaphore. Each playbook gets one template in the
# project, kept so that its tasks and their logs stay. Each run registers the
# node's key and an inventory, starts the task with that inventory, polls it
# every POLL_INTERVAL for at most TIMEOUT, and deletes the key and inventory.
export AIAPP_SEMAPHORE_URL=
export AIAPP_SEMAPHORE_TOKEN=
export AIAPP_SEMAPHORE_USERNAME=
export AIAPP_SEMAPHORE_PASSWORD=
export AIAPP_SEMAPHORE_PROJECT=aiapp
# Where deploy/ansible is mounted inside the Semaphore container.
export AIAPP_SEMAPHORE_PLAYBOOK_DIR=/ansible
export AIAPP_SEMAPHORE_POLL_INTERVAL=5s
export AIAPP_SEMAPHORE_TIMEOUT=30m

# Folder deployment files are placed in. Semaphore must see it at the same
# absolute path, so both mount the same volume there.
export AIAPP_STAGE_ROOT=/var/lib/aiapp/stage

# JSON file the records of POST /aiapp/deployments are written to and read back
# from at startup. Empty keeps them in memory, lost on restart. A record left
# running by a previous start is marked interrupted.
export AIAPP_DEPLOYMENT_STORE_FILE=

# Partner natural language agent (mock/partner/nlagent, not part of this
# prototype). `make run-mock-nl` starts it. It turns an instruction into calls
# to the automation engine tools over MCP through the planning LLM below. Its
# routes are under /aiapp/partner/nl; it requires AIAPP_AUTH_TOKEN of callers
# like every other process.
export AIAPP_MOCK_NL_PORT=8093
# Engine MCP server the mock takes its tools from.
export AIAPP_MOCK_NL_ENGINE_MCP_URL=http://127.0.0.1:8091/aiapp/engine/mcp
# Bearer token the mock sends to the engine MCP server. Empty falls back to
# AIAPP_APP_TOKEN.
export AIAPP_MOCK_NL_ENGINE_TOKEN=
# Upper bound on model turns for a single instruction.
export AIAPP_MOCK_NL_MAX_STEPS=12
# Directory holding the mock's run archive (JSON Lines).
export AIAPP_MOCK_NL_ARCHIVE_DIR=./data/partner-nl-archive
# Agent registry the mock registers its card with (POST <url>/agents). It first
# tries the engine MCP server up to 3 times, 5s apart, so the card lists the
# tools; a failed post is retried twice, 5s apart, and the mock keeps running
# unregistered after that. The outcome is shown under "registration" of
# GET /aiapp/partner/nl/card. Empty leaves registration off.
export AIAPP_MOCK_NL_REGISTRY_URL=
export AIAPP_MOCK_NL_REGISTRY_TOKEN=

# Anthropic Messages API endpoint and credentials of the mock's planning LLM.
# No Innogrid process reads these.
export AIAPP_LLM_BASE_URL=https://api.anthropic.com
export AIAPP_LLM_API_KEY=
export AIAPP_LLM_MODEL=claude-opus-5
export AIAPP_LLM_MAX_TOKENS=16000
export AIAPP_LLM_TIMEOUT=5m
